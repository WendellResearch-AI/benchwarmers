  "cards": [
    {
      "dot": "rose",
      "title": "Who may call",
      "items": [
        "Both servers bind 127.0.0.1; anywhere else they refuse to start without BENCHWARMERS_ADMIN_TOKEN",
        "Dashboard routes then take a login cookie; /v1, /bench, /mcp and Ollama's /api names take named, revocable gateway keys",
        "A Host allow-list on every request, and JSON-only, same-site writes, keep web pages out"
      ]
    },
    {
      "dot": "emerald",
      "title": "The loop",
      "items": [
        "Every seat answers with a call id and is logged as an unjudged offload",
        "Verdicts arrive by POST /bench/verdict, the MCP verdict tool, bench verdict or the dashboard",
        "Explorer seats go to the models unused longest; useful verdicts and suite findings rank route mode's member and the merger",
        ":merged adds one merger answer; :route gives an agent one member per turn, kept for the conversation, with failover"
      ]
    },
    {
      "dot": "amber",
      "title": "Scheduler jobs, off until Settings opts in",
      "items": [
        "Morning availability probe; suite passes; weekly speed and capability tests",
        "Catalog and Discover refresh; deprecation check with auto-retire",
        "Daily decisions benchmark: decide.py puts labelled questions to each decision model",
        "Results land in the data folder: perf history, suite answers, the scheduler log"
      ]
    },
    {
      "dot": "violet",
      "title": "Kept apart",
      "items": [
        "API keys are written by the Endpoints dialog and sign-ins, never into the data folder",
        "Export and import move the data folder as one zip; keys only if ticked",
        "Decision models are called on their endpoint's Decisions API, outside pacing and the ledger",
        "A hub can also run on this machine, where detection finds LiteLLM and CLI Proxy API"
      ]
    }
  ]
}
