# Copy to .env beside compose.yaml and fill in. .env is gitignored; keep it
# readable by you alone (chmod 600 .env).

# The name browsers use. Its DNS A (and AAAA) record must point at this server.
BENCH_DOMAIN=bench.example.com

# 16 or more characters: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
BENCHWARMERS_ADMIN_TOKEN=

# One per endpoint key name, upper-cased, '-' written as '_'. Or paste keys on
# the dashboard instead; those are kept in the data volume (llm/keys.json).
# BENCHWARMERS_KEY_OPENROUTER=sk-or-...
