*.json.lock
.*.part
keys.json
# compose.yaml's secrets (the admin token, BENCHWARMERS_KEY_*)
.env
__pycache__/
# pip wheel . / python -m build (pyproject.toml)
/dist/
/build/
*.egg-info/
suite/tasks/*/output/
